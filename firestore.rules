rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // อ่านข้อมูลร้านครั้งเดียวต่อการตรวจ (Firebase จำกัดการอ่านเพื่อตรวจสิทธิ์ 10 ครั้งต่อรายการ / 20 ครั้งต่อชุด)
    function signedIn() { return request.auth != null; }
    function shop(shopId) { return get(/databases/$(database)/documents/shops/$(shopId)).data; }
    function roleIn(s) { return s.members.get(request.auth.uid, ''); }
    function isMember(shopId) { return signedIn() && roleIn(shop(shopId)) != ''; }
    function isOwner(shopId) { return signedIn() && roleIn(shop(shopId)) == 'owner'; }
    // แก้ไขสต๊อกได้: เจ้าของร้านเสมอ / สมาชิกระดับ staff เมื่อเจ้าของไม่ได้ล็อกการแก้ไข (lockEdits)
    function canEdit(shopId) {
      let s = shop(shopId);
      let r = roleIn(s);
      return r == 'owner' || (r == 'staff' && s.get('lockEdits', false) == false);
    }

    // users/{uid}: บอกว่าผู้ใช้คนนี้อยู่ร้านไหน (อ่าน/เขียนได้เฉพาะของตัวเอง)
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /shops/{shopId} {
      allow read: if isMember(shopId);

      // สร้างร้านใหม่: ผู้สร้างต้องเป็น owner คนเดียว
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == 'owner';

      // owner แก้ได้ทุกอย่าง (เปลี่ยนสิทธิ์/ลบสมาชิก/ล็อกการแก้ไข)
      // คนที่มีรหัสร้านเข้าร่วมได้เฉพาะเพิ่มตัวเองเป็น "viewer" (ดูอย่างเดียว) จนกว่า owner จะอนุญาต
      allow update: if signedIn() && (
        roleIn(resource.data) == 'owner'
        || (!(request.auth.uid in resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid] == 'viewer'));

      // รายชื่อ/อีเมลสมาชิก: ทุกคนในร้านอ่านได้ เขียนได้เฉพาะของตัวเอง owner ลบได้
      match /people/{uid} {
        allow read: if isMember(shopId);
        allow create, update: if signedIn() && request.auth.uid == uid && isMember(shopId);
        allow delete: if isOwner(shopId);
      }

      match /products/{id} {
        allow read: if isMember(shopId);
        allow create, update: if signedIn() && canEdit(shopId);
        allow delete: if isOwner(shopId);
      }
      // ประวัติ: เพิ่มได้อย่างเดียว ห้ามแก้/ลบ (ย้อนดูได้จริง)
      match /movements/{id} {
        allow read: if isMember(shopId);
        allow create: if signedIn() && canEdit(shopId);
      }
      match /counts/{id} {
        allow read: if isMember(shopId);
        allow create: if signedIn() && canEdit(shopId);
      }
      // ยอดขาย/นับรายวัน: 1 เอกสารต่อวัน (YYYY-MM-DD)
      match /daily/{day} {
        allow read: if isMember(shopId);
        allow create, update: if signedIn() && canEdit(shopId);
      }
      // บันทึกการเพิ่ม/ลดในเมนูนับรายวัน: เพิ่มได้อย่างเดียว ห้ามแก้/ลบ
      match /dailyLog/{id} {
        allow read: if isMember(shopId);
        allow create: if signedIn() && canEdit(shopId);
      }
      // รายการสินค้านอกสต๊อก (ใช้เฉพาะเมนูนับรายวัน)
      match /dailyItems/{id} {
        allow read: if isMember(shopId);
        allow create, update, delete: if signedIn() && canEdit(shopId);
      }
    }
  }
}
